# ============================================================
# ADADIVE — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it's already in .gitignore.
# On Railway, set these in Project → Variables instead of a file.
# ============================================================

# ── Server ───────────────────────────────────────────────────���
NODE_ENV=production
PORT=5000

# ── Database (Railway provides this automatically when you add
#    a Postgres plugin — copy it from the Variables tab) ───────
DATABASE_URL=postgresql://user:password@host:port/database

# ── Pinata (IPFS pinning) ───────────────────────────────────────
# Get from pinata.cloud → API Keys → New Key
# ROTATE IMMEDIATELY if these were ever committed to git
PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_api_secret_here

# ── Solana (chain queries, escrow) ──────────────────────────────
# The cluster the api-server and browser read. The browser reaches it through
# Vite's /rpc proxy (see artifacts/cardano-storage/vite.config.ts).
# Devnet (testnet):
SOLANA_RPC_URL=https://api.devnet.solana.com
# Mainnet (when ready, swap to):
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Oracle backend ──────────────────────────────────────────────
# Where the browser finds the oracle service. Vite proxies /backend to this in
# development; set VITE_BACKEND_ENDPOINT to talk to a deployed backend directly.
BACKEND_URL=http://localhost:5001
# The oracle's public key. Deals are initialized against it and the backend
# refuses to register a deal naming any other oracle. Must match the key the
# backend loads (see ORACLE_SECRET_SOURCE below).
ORACLE_PUBKEY=
# Where the oracle backend gets its signing key: local-dev | env | secrets-manager.
# local-dev reads DEV_ORACLE_KEYPAIR_PATH and is refused when NODE_ENV=production.
ORACLE_SECRET_SOURCE=local-dev
# Development-only: a path to a throwaway localnet keypair (see
# scripts/devnet-setup.sh, which writes keys/oracle.json). Gitignored.
DEV_ORACLE_KEYPAIR_PATH=./keys/oracle.json
# Production instead sets ORACLE_SECRET_SOURCE=secrets-manager with
# ORACLE_KEYPAIR_SECRET_ID, or =env with ORACLE_KEYPAIR_SECRET injected.
# ORACLE_KEYPAIR_SECRET_ID=
# ORACLE_KEYPAIR_SECRET=
# The oracle backend reads the chain through the same SOLANA_RPC_URL above.

# ── Frontend build-time overrides (Vite) ────────────────────────
# Only needed when the app is built/served somewhere the proxies above do not
# exist (e.g. a static deploy). Leave unset to use the relative /rpc and
# /backend paths.
# VITE_RPC_ENDPOINT=https://api.devnet.solana.com
# VITE_SOLANA_CLUSTER=devnet
# VITE_BACKEND_ENDPOINT=https://your-oracle-backend.example
# VITE_ORACLE_PUBKEY=<same value as ORACLE_PUBKEY>
# Set on the hosted devnet demo build only: shows a "Devnet demo" banner so the
# seeded data is never mistaken for production.
# VITE_DEVNET_DEMO=1

# ── Admin access ─────────────────────────────────────────────────
# Used to protect /api/providers/applications and similar routes
# Generate a long random string, e.g. via: openssl rand -hex 32
ADMIN_SECRET=replace_with_long_random_string
ADMIN_PASSWORD=replace_with_a_new_strong_password

# ── Email (Gmail SMTP for provider application notifications) ──
# EMAIL_USER  = the Gmail address sending notifications
# EMAIL_PASS  = a 16-character Gmail "App Password", NOT your login
#               password. Create one at:
#               myaccount.google.com/security → App Passwords
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_app_password
ADMIN_EMAIL=where_you_want_to_receive_applications@gmail.com

# ── CORS — allowed frontend origins ──────────────────────────────
ALLOWED_ORIGIN=https://adadive.xyz

# ── Provider Reliability Agent (hackathon, advisory only) ────────
# A read-only advisor that turns provider status evidence into a structured
# risk assessment via the Meta Model API (Muse Spark). It never signs, releases
# funds, or changes a deal. See HACKATHON.md.
#
# The Meta key is read ONLY from the server env var META_API_KEY. Never commit a
# real key. Get one from the Model API dashboard (https://dev.meta.ai).
META_API_KEY=your_meta_model_api_key_here
# The Meta Model API endpoint, auth header and model id come from the official
# docs (https://dev.meta.ai/docs): base https://api.meta.ai/v1, header
# `Authorization: Bearer $META_API_KEY`, model muse-spark-1.3. Override only if
# Meta changes them.
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Per-request timeout against the Meta API.
META_TIMEOUT_MS=30000
# MOCK mode: set META_MOCK=1 to run with NO key and NO network — the advisor
# replays recorded fixture responses (artifacts/reliability-agent/src/fixtures).
META_MOCK=0

# Cost controls for the public advisory route. The per-IP limit stops one client
# from driving the spend; the daily cap is the global backstop on *live* Meta
# calls per UTC day. When the cap is hit the route serves a cached or
# fixture-based assessment with a "demo limit reached" note rather than failing.
# ADVISORY_DAILY_CALL_CAP=0 disables the daily cap (no cost concern).
ADVISORY_DAILY_CALL_CAP=200
ADVISORY_RATE_LIMIT_MAX=30
ADVISORY_RATE_LIMIT_WINDOW_MS=60000

# Hosted-demo seeding guard (see DEPLOY.md). The seed script refuses remote
# databases by default; seeding the hosted demo database requires BOTH of these,
# and refuses any host the repo docs name as production. Never set these against
# a production database.
# DEMO_SEED_ALLOW_REMOTE=1
# DEMO_SEED_CONFIRM_HOST=<exact database host>

# The read-only evidence route the advisor polls. Server-side callers use a
# shared internal token; a caller acting as the provider uses a wallet session
# token instead. Set the same INTERNAL_API_TOKEN on the api-server and the
# advisor; the api-server closes the internal route with a 503 when it is unset.
INTERNAL_API_TOKEN=replace_with_long_random_string
# RELIABILITY_AGENT_TOKEN=

# The provider id the CLI assesses when --provider is not given.
# PROVIDER_ID=

# ============================================================
# SETUP CHECKLIST
# ============================================================
# 1. Copy this file:        cp .env.example .env
# 2. Fill in every value above with real credentials
# 3. On Railway: add the same variables under Project → Variables
#    (Railway auto-injects DATABASE_URL when you attach Postgres)
# 4. Never commit .env — confirm it's in .gitignore
# 5. If any of these were EVER pushed to a public repo before,
#    rotate them now even if you've already done this once.
# ============================================================
