# ============================================================
# ADADIVE — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it's already in .gitignore.
# On Railway, set these in Project → Variables instead of a file.
# ============================================================

# ── Server ───────────────────────────────────────────────────���
NODE_ENV=production
PORT=5000

# ── Database (Railway provides this automatically when you add
#    a Postgres plugin — copy it from the Variables tab) ───────
DATABASE_URL=postgresql://user:password@host:port/database

# ── Pinata (IPFS pinning) ───────────────────────────────────────
# Get from pinata.cloud → API Keys → New Key
# ROTATE IMMEDIATELY if these were ever committed to git
PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_api_secret_here

# ── Koios (Cardano blockchain queries) ──────────────────────────
# No API key needed — just the base URL
# Preprod (testnet):
KOIOS_URL=https://preprod.koios.rest/api/v1
# Mainnet (when ready, swap to):
# KOIOS_URL=https://api.koios.rest/api/v1

# ── Admin access ─────────────────────────────────────────────────
# Used to protect /api/providers/applications and similar routes
# Generate a long random string, e.g. via: openssl rand -hex 32
ADMIN_SECRET=replace_with_long_random_string
ADMIN_PASSWORD=replace_with_a_new_strong_password

# ── Email (Gmail SMTP for provider application notifications) ──
# EMAIL_USER  = the Gmail address sending notifications
# EMAIL_PASS  = a 16-character Gmail "App Password", NOT your login
#               password. Create one at:
#               myaccount.google.com/security → App Passwords
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_app_password
ADMIN_EMAIL=where_you_want_to_receive_applications@gmail.com

# ── CORS — allowed frontend origins ──────────────────────────────
ALLOWED_ORIGIN=https://adadive.xyz

# ============================================================
# SETUP CHECKLIST
# ============================================================
# 1. Copy this file:        cp .env.example .env
# 2. Fill in every value above with real credentials
# 3. On Railway: add the same variables under Project → Variables
#    (Railway auto-injects DATABASE_URL when you attach Postgres)
# 4. Never commit .env — confirm it's in .gitignore
# 5. If any of these were EVER pushed to a public repo before,
#    rotate them now even if you've already done this once.
# ============================================================
