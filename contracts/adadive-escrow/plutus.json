    },
    "Int": {
      "dataType": "integer"
    },
    "adadive/types/DealDatum": {
      "title": "DealDatum",
      "description": "The datum attached to an escrowed deal UTxO.",
      "anyOf": [
        {
          "title": "DealDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "client",
              "description": "Client who funded the deal and may reclaim on expiry/cancellation.",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "provider",
              "description": "Provider who receives payment on successful settlement.",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "oracle",
              "description": "Trusted arbiter that attests proof-of-storage in the v1 oracle model.",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "data_hash",
              "description": "Hash / IPFS CID of the stored data this deal covers.",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "payment",
              "description": "Amount escrowed for the provider, in **lovelace**. Enforced on-chain: a\n `Settle` must pay at least this much to the provider and a `Refund` at\n least this much to the client (see `adadive/escrow.validate`).",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "storage_gb",
              "description": "Storage size in gigabytes the provider committed to.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "duration_epochs",
              "description": "Storage duration in Cardano epochs.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "start_time",
              "description": "POSIX time (ms) when the deal became active.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "deadline",
              "description": "POSIX time (ms) by which the provider must settle; afterwards the client\n may unilaterally refund.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "model",
              "description": "Settlement model in force. v1 requires `OracleAttested`.",
              "$ref": "#/definitions/adadive~1types~1SettlementModel"
            },
            {
              "title": "challenge_window",
              "description": "v2 challenge window length (ms). Ignored by v1; set to 0 for v1 deals.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "phase",
              "description": "Current lifecycle phase. v1 requires `Locked`.",
              "$ref": "#/definitions/adadive~1types~1DealPhase"
            }
          ]
        }
      ]
    },
    "adadive/types/DealPhase": {
      "title": "DealPhase",
      "description": "Lifecycle phase of the escrowed deal. v1 only ever sees `Locked`; the other\n phases exist so v2's claim/challenge flow slots in without a datum change.",
      "anyOf": [
        {
          "title": "Locked",
          "description": "Funds are escrowed; awaiting settlement, refund, or cancellation.",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "Claimed",
          "description": "v2 (reserved): provider has posted a completion claim; challenge window\n is open until `challenge_deadline`.",
          "dataType": "constructor",
          "index": 1,
          "fields": [
            {
              "title": "challenge_deadline",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "adadive/types/DealRedeemer": {
      "title": "DealRedeemer",
      "description": "Actions that can be taken against an escrowed deal UTxO.\n\n Constructors are append-only: v2 will add `ProviderClaim`, `Challenge`, and\n `Finalize` without removing or reordering these, so existing off-chain\n encoders remain valid.",
      "anyOf": [
        {
          "title": "Settle",
          "description": "v1: oracle + provider co-sign to release payment to the provider.",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "Refund",
          "description": "Client reclaims the escrow after `deadline` has passed with no settlement.",
          "dataType": "constructor",
          "index": 1,
          "fields": []
        },
        {
          "title": "Cancel",
          "description": "Client and provider mutually agree to unwind the deal at any time.",
          "dataType": "constructor",
          "index": 2,
          "fields": []
        }
      ]
    },
    "adadive/types/SettlementModel": {
      "title": "SettlementModel",
      "description": "Which settlement rules govern a deal. v1 deals are always `OracleAttested`.\n `OptimisticChallenge` is reserved for v2 and is rejected by the v1\n validator, so a v1 script can never be tricked into running v2 semantics.",
      "anyOf": [
        {
          "title": "OracleAttested",
          "description": "v1: a trusted arbiter (`oracle`) co-signs settlement to attest that the\n provider has demonstrated valid proof-of-storage off-chain.",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "OptimisticChallenge",
          "description": "v2 (reserved): provider claims optimistically; anyone may submit a fraud\n proof during `challenge_window` before funds finalize.",
          "dataType": "constructor",
          "index": 1,
          "fields": []
        }
      ]
    },
    "aiken/crypto/VerificationKeyHash": {
      "title": "VerificationKeyHash",
      "dataType": "bytes"
    }
  }
}