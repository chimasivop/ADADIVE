{
  "name": "@workspace/reliability-agent",
  "version": "0.1.0",
  "private": true,
  "description": "ADADIVE provider reliability advisor: turns read-only provider evidence into a structured risk assessment via the Meta Model API (Muse Spark). Advisory only — never signs, releases funds, or changes a deal.",
  "type": "module",
  "exports": {
    ".": "./src/lib.ts",
    "./advisory": "./src/advisory.ts"
  },
  "scripts": {
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "dev": "tsx ./src/index.ts",
    "assess": "tsx ./src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "ts-mocha -p tsconfig.test.json -t 30000 'tests/*.test.ts'"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.1.0",
    "@types/node": "catalog:",
    "chai": "^4.5.0",
    "esbuild": "catalog:",
    "mocha": "^10.8.2",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  }
}
