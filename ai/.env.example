# ADADIVE AI Service Configuration
# Copy this file to .env and configure your settings

# ===================
# API Settings
# ===================
AI_API_HOST=0.0.0.0
AI_API_PORT=8000
AI_API_DEBUG=false

# Comma-separated list of allowed CORS origins
AI_ALLOWED_ORIGINS=http://localhost:3000,https://adadive.xyz

# ===================
# LLM Provider
# ===================
# Options: openai, anthropic, ollama
AI_LLM_PROVIDER=openai

# OpenAI Configuration
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-3-haiku-20240307

# Ollama Configuration (for local models)
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3.2

# ===================
# Backend API Integration
# ===================
# URL of the ADADIVE backend API (for user data)
AI_BACKEND_API_BASE_URL=http://localhost:3001
AI_BACKEND_API_TIMEOUT=30

# ===================
# Retrieval (RAG)
# ===================
# Knowledge base is auto-loaded from knowledge/ directory
AI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_EMBEDDING_DIMENSION=384
AI_RETRIEVAL_TOP_K=5
AI_RETRIEVAL_SCORE_THRESHOLD=0.5

# ===================
# Authentication
# ===================
# Enable JWT authentication for user-specific queries
AI_AUTH_ENABLED=false
AI_JWT_SECRET=your-secret-key-here-change-in-production
AI_JWT_ALGORITHM=HS256
AI_JWT_EXPIRATION_MINUTES=60

# ===================
# Security
# ===================
# Maximum message length in characters
AI_MAX_MESSAGE_LENGTH=4000

# Rate limiting
AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60

# ===================
# Feature Flags
# ===================
# Enable retrieval-augmented generation
AI_ENABLE_RAG=true

# Enable querying user-specific deal data through backend API
AI_ENABLE_USER_CONTEXT=false
